{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types", "chrome"],
    "allowJs": true
  },
  "include": ["daemon", "cli", "scripts", "extension", "layout"]
}
